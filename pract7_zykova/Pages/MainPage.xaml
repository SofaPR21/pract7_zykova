<Page x:Class="pract7_zykova.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pract7_zykova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главная">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Click="go_form" Margin="5">Добавить</Button>
            <Button Click="remove" Margin="5">Удалить</Button>
            <Button Click="remove" Margin="5">Фильтровать</Button>
        </StackPanel>

        <ListView Grid.Row="1" MouseDoubleClick="Edit">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock/>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" 
                                     VerticalAlignment="Center">
                                <TextBlock Text="Создан:" 
                                        FontSize="10" Foreground="#888888" 
                                        HorizontalAlignment="Right"/>
                                <TextBlock/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
